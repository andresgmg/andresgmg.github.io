---
import { experience, profile } from '../data';
import type { Lang } from '../data/types';
import { anchor, useTranslations } from '../i18n/utils';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/profile.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** Years of experience, computed from the earliest role so it never goes stale. */
const earliest = experience.map((e) => e.start).sort()[0];
const [startYear, startMonth] = (earliest ?? '').split('-').map(Number);
const now = new Date();
const months =
  (now.getUTCFullYear() - (startYear ?? now.getUTCFullYear())) * 12 +
  (now.getUTCMonth() + 1 - (startMonth ?? 1));
const years = Math.max(1, Math.floor(months / 12));

const stats = [{ value: `${years}+`, label: t('hero.stats.years') }].concat(
  profile.stats.map((s) => ({ value: s.value, label: s.label[lang] })),
);
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-text">
      <a class="hero-badge" href={anchor(lang, 'contact')}>
        <span class="hero-badge-dot" aria-hidden="true"></span>
        {t('hero.available')}
      </a>
      <p class="hero-greeting">{t('hero.greeting')}</p>
      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-headline">{profile.headline[lang]}</p>
      <p class="hero-tagline muted">{profile.tagline[lang]}</p>

      <p class="hero-location muted">
        <Icon name="location" size={16} />
        <span>{t('hero.location')} {profile.location[lang]}</span>
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={anchor(lang, 'contact')}>{t('hero.cta.contact')}</a>
        <a class="btn btn-outline" href={anchor(lang, 'projects')}>{t('hero.cta.projects')}</a>
      </div>

      <div class="hero-downloads">
        <a class="btn btn-ghost" href={profile.cv.en} download>
          <Icon name="download" size={16} />
          {t('hero.cta.downloadEn')}
        </a>
        <a class="btn btn-ghost" href={profile.cv.es} download>
          <Icon name="download" size={16} />
          {t('hero.cta.downloadEs')}
        </a>
      </div>

      <ul class="hero-socials">
        {
          profile.socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="hero-social"
                aria-label={s.label}
                rel="noopener noreferrer"
                target={s.href.startsWith('http') ? '_blank' : undefined}
              >
                <Icon name={s.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-media">
      <div class="hero-photo-wrap">
        <Image
          class="hero-photo"
          src={profilePhoto}
          widths={[320, 640]}
          sizes="(min-width: 48rem) 20rem, 60vw"
          width={640}
          height={640}
          format="webp"
          quality={82}
          alt={profile.name}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>

  <div class="container">
    <dl class="hero-stats" aria-label={t('hero.stats.ariaLabel')}>
      {
        stats.map((s) => (
          <div class="hero-stat card">
            <dd class="hero-stat-value">{s.value}</dd>
            <dt class="hero-stat-label muted">{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4rem);
  }

  /* Soft accent glow behind the hero (decorative only) */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(42rem 42rem at 85% 20%, var(--accent-soft), transparent 60%),
      radial-gradient(30rem 30rem at 5% 95%, var(--accent-soft), transparent 65%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem 0.35rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 1.25rem;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero-badge:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero-badge-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .hero-greeting {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--accent);
  }

  .hero-name {
    font-size: clamp(2.1rem, 6vw, 3.25rem);
    margin-top: 0.35rem;
  }

  .hero-headline {
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    font-weight: 600;
    color: var(--heading);
    margin-top: 0.6rem;
  }

  .hero-tagline {
    font-size: 1rem;
    margin-top: 0.6rem;
    max-width: 38ch;
  }

  .hero-location {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    margin-top: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-downloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .btn-ghost {
    background: var(--surface-2);
    color: var(--ink);
    border-color: var(--border);
    font-size: 0.9rem;
  }

  .btn-ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hero-socials {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
  }

  .hero-social {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.15s ease;
  }

  .hero-social:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .hero-media {
    display: flex;
    justify-content: center;
  }

  .hero-photo-wrap {
    position: relative;
    padding: 0.4rem;
    border-radius: 50%;
    background: conic-gradient(from 180deg, var(--accent), var(--accent-soft), var(--accent));
  }

  .hero-photo {
    width: clamp(13rem, 40vw, 20rem);
    height: clamp(13rem, 40vw, 20rem);
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--bg);
    box-shadow: var(--shadow-md);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1rem 1.25rem;
  }

  .hero-stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .hero-stat-label {
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge-dot {
      animation: none;
    }
  }

  @media (min-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1.35fr 1fr;
    }

    .hero-media {
      order: 1;
    }
  }
</style>
