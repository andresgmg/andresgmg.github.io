---
import {
  certifications,
  education,
  experience,
  profile,
  skillCategories,
  spokenLanguages,
} from '../data';
import type { Lang } from '../data/types';
import { formatDateRange, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const linkedin = profile.socials.find((s) => s.icon === 'linkedin');
const github = profile.socials.find((s) => s.icon === 'github');
const strip = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');

/** Contact line: plain text entries plus real links (Chromium keeps them clickable in the PDF). */
const contactItems: { text: string; href?: string }[] = [
  { text: profile.location[lang] },
  { text: profile.email, href: `mailto:${profile.email}` },
  { text: profile.phone, href: profile.phoneHref },
  { text: strip(profile.website), href: profile.website },
  ...(linkedin ? [{ text: strip(linkedin.href), href: linkedin.href }] : []),
  ...(github ? [{ text: strip(github.href), href: github.href }] : []),
];

const work = experience.filter((e) => e.kind === 'work');
const freelance = experience.filter((e) => e.kind === 'freelance');

const experienceGroups = [
  { label: t('cv.experience'), items: work },
  { label: t('experience.freelance'), items: freelance },
];
---

<div class="cv-toolbar no-print">
  <a href={`/${lang === 'en' ? '' : 'es/'}`} class="tool-link">← {t('cv.backToSite')}</a>
  <button id="cv-print" type="button" class="tool-btn">{t('cv.print')}</button>
</div>

<article class="cv-page">
  <header class="cv-header">
    <h1 class="cv-name">{profile.name}</h1>
    <p class="cv-headline">{profile.headline[lang]}</p>
    <p class="cv-contact">
      {
        contactItems.map((item, i) => (
          <>
            {i > 0 && <span class="sep">·</span>}
            {item.href ? <a href={item.href}>{item.text}</a> : <span>{item.text}</span>}
          </>
        ))
      }
    </p>
  </header>

  <section class="cv-section">
    <h2 class="cv-h2">{t('cv.summary')}</h2>
    <p class="cv-summary">{profile.summary[lang]}</p>
  </section>

  <section class="cv-section">
    <h2 class="cv-h2">{t('cv.competencies')}</h2>
    <ul class="cv-competencies">
      {
        skillCategories.map((cat) => (
          <li>
            <strong>{cat.name[lang]}:</strong> {(cat.cvSkills ?? cat.skills).join(', ')}
          </li>
        ))
      }
    </ul>
  </section>

  {
    experienceGroups.map((group) => (
      <section class="cv-section">
        <h2 class="cv-h2">{group.label}</h2>
        {group.items.map((e) => (
          <div class="cv-role">
            <div class="cv-role-head">
              <span class="cv-role-title">
                {e.title[lang]} — {e.company}
              </span>
              <span class="cv-role-dates">{formatDateRange(e.start, e.end, lang)}</span>
            </div>
            <p class="cv-role-meta">{e.location[lang]}</p>
            <ul class="cv-bullets">
              {e.highlights[lang].map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }

  <section class="cv-section">
    <h2 class="cv-h2">{t('cv.education')}</h2>
    {
      education.map((ed) => (
        <div class="cv-role">
          <div class="cv-role-head">
            <span class="cv-role-title">
              {ed.degree[lang]} — {ed.institution}
            </span>
            <span class="cv-role-dates">
              {ed.start} – {ed.end}
            </span>
          </div>
          <p class="cv-role-meta">{ed.location[lang]}</p>
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2 class="cv-h2">{t('cv.certifications')}</h2>
    <ul class="cv-certs">
      {
        certifications.map((c) => (
          <li>
            <strong>{c.name[lang]}</strong> — {c.issuer}
            {c.year && <span class="cv-cert-year"> ({c.year})</span>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-section">
    <h2 class="cv-h2">{t('cv.languages')}</h2>
    <p class="cv-languages">
      {spokenLanguages.map((l) => `${l.name[lang]} (${l.level[lang]})`).join(' · ')}
    </p>
  </section>
</article>

<style>
  .cv-toolbar {
    max-width: 820px;
    margin: 1.25rem auto 0;
    padding-inline: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 14px;
  }

  .tool-link {
    color: var(--cv-accent);
    font-weight: 600;
  }

  .tool-btn {
    border: 1px solid var(--cv-accent);
    background: var(--cv-accent);
    color: #fff;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    font-size: 14px;
  }

  .cv-page {
    max-width: 820px;
    margin: 1rem auto 3rem;
    background: #fff;
    padding: 2.5rem 2.75rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
  }

  .cv-header {
    border-bottom: 2px solid var(--cv-accent);
    padding-bottom: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .cv-name {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--cv-accent);
  }

  .cv-headline {
    font-size: 12px;
    font-weight: 600;
    color: var(--cv-ink);
    margin-top: 0.1rem;
  }

  .cv-contact {
    font-size: 9.5px;
    color: var(--cv-muted);
    margin-top: 0.35rem;
    line-height: 1.6;
  }

  .cv-contact .sep {
    margin-inline: 0.35rem;
    color: var(--cv-rule);
  }

  .cv-section {
    margin-top: 0.7rem;
  }

  .cv-h2 {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cv-accent);
    border-bottom: 1px solid var(--cv-rule);
    padding-bottom: 0.15rem;
    margin-bottom: 0.4rem;
    break-after: avoid;
  }

  .cv-summary {
    text-align: justify;
  }

  .cv-competencies {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }

  .cv-competencies strong,
  .cv-certs strong {
    color: var(--cv-ink);
  }

  .cv-role {
    margin-bottom: 0.55rem;
    break-inside: avoid;
  }

  .cv-role-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .cv-role-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--cv-ink);
  }

  .cv-role-dates {
    font-size: 9.5px;
    font-weight: 500;
    color: var(--cv-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .cv-role-meta {
    font-size: 9.5px;
    font-style: italic;
    color: var(--cv-muted);
    margin-bottom: 0.15rem;
  }

  .cv-bullets {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.12rem;
  }

  .cv-bullets li {
    position: relative;
    padding-left: 0.85rem;
  }

  .cv-bullets li::before {
    content: '▪';
    position: absolute;
    left: 0;
    color: var(--cv-accent);
    font-size: 8px;
    top: 1px;
  }

  .cv-certs {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.12rem;
  }

  .cv-certs li {
    break-inside: avoid;
  }

  .cv-cert-year {
    color: var(--cv-muted);
  }

  .cv-languages {
    font-size: 10.5px;
  }

  @media print {
    .cv-page {
      max-width: none;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
  }
</style>

<script>
  document.getElementById('cv-print')?.addEventListener('click', () => window.print());
</script>
