---
import '@fontsource-variable/inter';
import { profile } from '../data';
import type { Lang } from '../data/types';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="author" content={profile.name} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --cv-ink: #1a1d24;
    --cv-muted: #4a5160;
    --cv-accent: #2b3a55;
    --cv-rule: #c9d0db;
    --cv-bg: #eef1f5;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family:
      'Inter Variable',
      'Inter',
      system-ui,
      -apple-system,
      'Segoe UI',
      Roboto,
      Arial,
      sans-serif;
    color: var(--cv-ink);
    background: var(--cv-bg);
    line-height: 1.42;
    font-size: 10.5px;
    orphans: 2;
    widows: 2;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  @page {
    size: A4;
    margin: 12mm 14mm;
  }

  @media print {
    body {
      background: #ffffff;
    }

    .no-print {
      display: none !important;
    }
  }
</style>
